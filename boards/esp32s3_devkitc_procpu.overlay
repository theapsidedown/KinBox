#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	aliases {
		led-strip = &led_strip;
	};

	/*
	 * KinBox buttons. Wire each button between the GPIO and GND;
	 * the internal pull-up is enabled, so a press reads as logic 0.
	 *
	 *   D-pad UP    -> GPIO4      A (select)    -> GPIO8
	 *   D-pad DOWN  -> GPIO5      B (open menu) -> GPIO9
	 *   D-pad LEFT  -> GPIO6
	 *   D-pad RIGHT -> GPIO7
	 */
	buttons {
		compatible = "gpio-keys";
		debounce-interval-ms = <30>;

		btn_up: btn_up {
			label = "D-pad Up";
			gpios = <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_UP>;
		};
		btn_down: btn_down {
			label = "D-pad Down";
			gpios = <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_DOWN>;
		};
		btn_left: btn_left {
			label = "D-pad Left";
			gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_LEFT>;
		};
		btn_right: btn_right {
			label = "D-pad Right";
			gpios = <&gpio0 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_RIGHT>;
		};
		btn_a: btn_a {
			label = "A (select)";
			gpios = <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_ENTER>;
		};
		btn_b: btn_b {
			label = "B (menu)";
			gpios = <&gpio0 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_MENU>;
		};
	};
};

&i2s0_default {
	group1 {
		pinmux = <I2S0_O_SD_GPIO48>;
	};
};

i2s_led: &i2s0 {
	status = "okay";

	dmas = <&dma 3>;
	dma-names = "tx";

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-i2s";

		reg = <0>;
		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		reset-delay = <500>;
	};
};

&dma {
	status = "okay";
};

&flash0 {
    reg = <0x0 DT_SIZE_M(16)>;
};
